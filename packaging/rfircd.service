# systemd unit for rfircd.
#
#   install -m0755 target/release/rfircd /usr/local/bin/
#   install -m0640 -o rfircd rfircd.toml /etc/rfircd.toml
#   useradd --system --no-create-home --shell /usr/sbin/nologin rfircd
#   systemctl enable --now rfircd
#
# If the TNC is a serial port, add the service user to the dialout group and
# drop the DevicePolicy line below.

[Unit]
Description=rfircd (IRC server with RF gateway over KISS/Direwolf)
Documentation=file:/usr/share/doc/rfircd/design.md
After=network-online.target direwolf.service
Wants=network-online.target

[Service]
Type=simple
User=rfircd
Group=rfircd
ExecStart=/usr/local/bin/rfircd --config /etc/rfircd.toml
ExecStartPre=/usr/local/bin/rfircd --check --config /etc/rfircd.toml
Environment=RUST_LOG=rfircd=info
Restart=on-failure
RestartSec=5s

# The station stops transmitting when the service stops. SIGINT gives it the
# chance to send a closing identification first, which is why the stop signal
# is not the default SIGTERM.
KillSignal=SIGINT
TimeoutStopSec=15s

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryDenyWriteExecute=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
