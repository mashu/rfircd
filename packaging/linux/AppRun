#!/bin/sh
# AppImage entry: default is the gateway. Subcommands select the other binaries.
#   ./rfircd-x86_64.AppImage -c ~/.config/rfircd/rfircd.toml
#   ./rfircd-x86_64.AppImage station --call SM0ABC-7 --gateway SK0MT-1
#   ./rfircd-x86_64.AppImage kisshub --bind 127.0.0.1:8001
#
# If you symlink the AppImage to rfirc-station or rfirc-kisshub, argv0
# selects that binary instead.

set -eu

HERE=$(dirname "$(readlink -f "$0")")
BIN="$HERE/usr/bin"

wrapper_help() {
    cat <<'EOF'
rfircd AppImage — IRC server with an RF gateway (KISS/Direwolf)

  ./rfircd-*.AppImage [rfircd options]
  ./rfircd-*.AppImage station  --call CALL --gateway CALL [options]
  ./rfircd-*.AppImage kisshub  [--bind 127.0.0.1:8001] [--quiet]
  ./rfircd-*.AppImage gateway  [rfircd options]

QMX on Debian: https://mashu.github.io/rfircd/
EOF
}

name=$(basename "${ARGV0:-$0}" .AppImage)
name=${name%.appimage}

case "$name" in
    rfirc-station*) exec "$BIN/rfirc-station" "$@" ;;
    rfirc-kisshub*) exec "$BIN/rfirc-kisshub" "$@" ;;
esac

if [ "${1:-}" = "--appimage-help" ] || [ "${1:-}" = "--wrapper-help" ]; then
    wrapper_help
    exit 0
fi

case "${1:-}" in
    station|rfirc-station)
        shift
        exec "$BIN/rfirc-station" "$@"
        ;;
    kisshub|rfirc-kisshub)
        shift
        exec "$BIN/rfirc-kisshub" "$@"
        ;;
    gateway|rfircd)
        shift
        exec "$BIN/rfircd" "$@"
        ;;
    -h|--help)
        wrapper_help
        echo
        exec "$BIN/rfircd" --help
        ;;
    *)
        exec "$BIN/rfircd" "$@"
        ;;
esac
